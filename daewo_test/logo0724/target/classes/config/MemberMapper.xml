<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="repository.MemberMapper">

<insert id="insert" parameterType="model.Member" useGeneratedKeys="false">
  INSERT INTO MEMBER (id, username, password, name, email)
  VALUES (member_seq.NEXTVAL, #{username}, #{password}, #{name}, #{email})
</insert>


<select id="findByUsername" parameterType="string" resultType="model.Member">
  SELECT * FROM MEMBER WHERE username = #{username}
</select>


</mapper>
